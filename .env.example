# Copy this file to .env and fill in the values. Never commit .env.

# Password for the admin page (required). Pick a long one.
ADMIN_PASSWORD=

# Random string used to sign the admin login cookie (recommended).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, a new one is made at every start and admins are logged out on restart.
SESSION_SECRET=

# Address students' phones use to reach the site. This is what goes inside the QR codes.
# Local testing on the same Wi-Fi: http://YOUR-COMPUTER-IP:3000
# Deployed: https://your-app.example.com
BASE_URL=

# Port to listen on.
PORT=3000

# Where the SQLite database file lives.
DATABASE_PATH=./data/checkout.db

# Optional: only accept school emails from this domain (example: myschool.edu). Empty = any email.
SCHOOL_EMAIL_DOMAIN=

# Optional: time zone for due dates and displayed times (example: America/Chicago).
TZ=

# Set to 1 when running behind a hosting provider's HTTPS proxy (Fly.io, Render, Railway).
TRUST_PROXY=
