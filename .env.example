# Copy this file to .env and fill in the values. Never commit .env.

# Sign-up codes for staff accounts. Staff sign up at /admin/signup with their own email and password.
# Give the admin code only to administrators: an admin sees all student data.
# Give the teacher code to teachers: a teacher lists items and sees check-outs of their own items only.
# Use two different codes, 8 characters or more. Leave one empty to close that kind of sign-up.
# Tip: after everyone has signed up, empty both and restart to close sign-up.
ADMIN_SIGNUP_CODE=
TEACHER_SIGNUP_CODE=

# Random string used to sign the staff login cookie (recommended).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, a new one is made at every start and staff are logged out on restart.
SESSION_SECRET=

# Address students' phones use to reach the site. This is what goes inside the QR codes.
# Local testing on the same Wi-Fi: http://YOUR-COMPUTER-IP:3000
# Deployed: https://your-app.example.com (on Render, leave empty: the address is detected)
BASE_URL=

# Port to listen on.
PORT=3000

# Where the data lives.
# Local: a SQLite file at DATABASE_PATH (used when TURSO_DATABASE_URL is empty).
DATABASE_PATH=./data/checkout.db
# Hosted: a free Turso database (https://turso.tech). Set both to use it instead of the local file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: only accept school emails from this domain (example: myschool.edu). Empty = any email.
SCHOOL_EMAIL_DOMAIN=

# Optional: time zone for due dates and displayed times (example: America/Chicago).
TZ=

# Set to 1 when running behind a hosting provider's HTTPS proxy (Fly.io, Render, Railway).
TRUST_PROXY=
